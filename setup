#!/usr/bin/env bash
# Boots installer. Connects each Boots skill to Claude Code so that updating Boots
# later (`git pull` in this folder) updates every project at once — no re-copying.
#
#   ./setup            # install for every project (into ~/.claude/skills)
#   ./setup --project  # install for just this project (into ./.claude/skills)
#   ./setup --uninstall # disconnect the Boots skills this script added
#
# It only touches the Boots skills (folders named boots*) and nothing else.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
SRC_DIR="$REPO_ROOT/.claude/skills"

MODE="global"
ACTION="install"
for arg in "$@"; do
  case "$arg" in
    --project) MODE="project" ;;
    --uninstall) ACTION="uninstall" ;;
    -h|--help)
      cat <<'USAGE'
Boots installer — connects each Boots skill to Claude Code so that updating Boots
later (git pull in this folder) updates every project at once.

  ./setup             install for every project (into ~/.claude/skills)
  ./setup --project   install for just this project (into ./.claude/skills)
  ./setup --uninstall disconnect the Boots skills this script added

It only touches the Boots skills (folders named boots*) and nothing else.
USAGE
      exit 0 ;;
    *) echo "unknown flag: $arg" >&2; exit 2 ;;
  esac
done

if [ "$MODE" = "project" ]; then
  DEST_DIR="$PWD/.claude/skills"
else
  DEST_DIR="$HOME/.claude/skills"
fi

if [ ! -d "$SRC_DIR" ]; then
  echo "error: no Boots skills found at $SRC_DIR — run setup from the folder you cloned Boots into" >&2
  exit 1
fi

# Regenerate each SKILL.md from its SKILL.md.tmpl (universal preamble injection).
# The generated SKILL.md files are committed, so this is a refresh, not a hard
# requirement — without bun we install the committed copies as-is.
if [ "$ACTION" = "install" ] && ls "$SRC_DIR"/boots*/SKILL.md.tmpl >/dev/null 2>&1; then
  if command -v bun >/dev/null 2>&1; then
    echo "refreshing skills from templates..."
    ( cd "$REPO_ROOT" && bun run gen:skill-docs >/dev/null ) \
      || echo "warning: skill regeneration failed — installing committed SKILL.md as-is" >&2
  else
    echo "note: bun not found — installing committed SKILL.md as-is (install bun to edit templates)."
  fi
fi

mkdir -p "$DEST_DIR"

linked=0
for src in "$SRC_DIR"/boots*/; do
  [ -d "$src" ] || continue
  name="$(basename "$src")"
  dest="$DEST_DIR/$name"

  if [ "$ACTION" = "uninstall" ]; then
    # Only remove a link we would have created; never touch a real folder.
    if [ -L "$dest" ]; then rm -f "$dest"; echo "disconnected  $name"; linked=$((linked+1)); fi
    continue
  fi

  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    echo "skipped  $name — something's already at $dest, leaving it alone" >&2
    continue
  fi
  ln -snf "${src%/}" "$dest"
  echo "connected  $name"
  linked=$((linked+1))
done

echo
if [ "$ACTION" = "uninstall" ]; then
  echo "Disconnected $linked Boots skill(s) from $DEST_DIR."
  echo "You can also delete the '## Boots' section from your CLAUDE.md."
  exit 0
fi

# ─── Version migrations (idempotent, gated by last-setup-version) ──────
# Run any migrations/v*.sh newer than the version last set up. A fresh install
# (no marker) skips them and just stamps the marker. See migrations/README.md.
MIGRATIONS_DIR="$REPO_ROOT/migrations"
CURRENT_VERSION="$(cat "$REPO_ROOT/VERSION" 2>/dev/null || echo unknown)"
LAST_FILE="$HOME/.boots/.last-setup-version"
LAST_VERSION="$(cat "$LAST_FILE" 2>/dev/null || echo '0.0.0.0')"
if [ -d "$MIGRATIONS_DIR" ] && [ "$CURRENT_VERSION" != "unknown" ] && [ "$LAST_VERSION" != "$CURRENT_VERSION" ] && [ -f "$LAST_FILE" ]; then
  for m in $(find "$MIGRATIONS_DIR" -maxdepth 1 -name 'v*.sh' -type f 2>/dev/null | sort -V); do
    mv="$(basename "$m" .sh | sed 's/^v//')"
    if [ "$(printf '%s\n%s' "$LAST_VERSION" "$mv" | sort -V | head -1)" = "$LAST_VERSION" ] && [ "$LAST_VERSION" != "$mv" ] \
       && [ "$(printf '%s\n%s' "$mv" "$CURRENT_VERSION" | sort -V | tail -1)" = "$CURRENT_VERSION" ]; then
      echo "  running migration $mv…"; bash "$m" || echo "  warning: migration $mv had errors (non-fatal)"
    fi
  done
fi
mkdir -p "$HOME/.boots"
[ "$CURRENT_VERSION" != "unknown" ] && echo "$CURRENT_VERSION" > "$LAST_FILE"

echo "Boots is installed — $linked skill(s) connected in $DEST_DIR."
echo "To update Boots later, run:  cd \"$REPO_ROOT\" && git pull  (every project updates at once)."
echo
echo "Last step: paste this into your project's CLAUDE.md so Claude Code knows Boots is here:"
echo
cat <<'BLOCK'
## Boots
Boots helps you build and finish AI systems, one step at a time. Say `boots` and it
tells you the single next step on whatever you're building — or just say what you want
to build and it walks you from a fuzzy idea to a finished tool.
Skills: boots, boots-clarify, boots-scope, boots-build, boots-review, boots-verify,
boots-ship, boots-prospect, boots-track, boots-surface, boots-rethink, boots-extract,
boots-retire, boots-observe.
Boots keeps its notes in ~/.boots/systems/ (your machine, private, out of any repo), so
your systems are there no matter which project you're in. To see one, just ask Boots —
it reads the record and opens what it built for you.
First run: if `~/.boots/.activated` does not exist yet, open the session by running
Boots — the person just installed it and may not know to ask. Boots introduces itself
and shows what a finished system looks like before anything else.
BLOCK
