#!/usr/bin/env bash
# boots-update-check — periodic version check, called silently by every preamble.
#
# Output (one line, or nothing):
#   JUST_UPGRADED <old> <new>       — marker from a recent upgrade
#   UPGRADE_AVAILABLE <old> <new>   — remote VERSION is strictly newer
#   (nothing)                       — up to date, snoozed, disabled, no remote, or offline
#
# Adapted to Boots' layout: the skill installs at
# .claude/skills/boots/, so this resolves UP to the repo root (where VERSION + .git
# live) instead of assuming skill-dir == repo-root. The remote is derived from the
# repo's own `origin` (Boots has no single canonical repo — every user's clone/fork
# is its own upstream), so this is dormant until Boots is pushed to a git remote.
#
# Silence is the failure mode: no remote, no network, a captive portal, or a flaky
# fetch all resolve to "print nothing", so a bad connection never wedges a skill.
#
# Env overrides (testing):
#   BOOTS_DIR          — override the resolved repo root
#   BOOTS_STATE_DIR    — override ~/.boots
#   BOOTS_REMOTE_REPO  — override the git remote URL
set -uo pipefail

_SELF="$(cd "$(dirname "$0")" && pwd -P)"
BOOTS_DIR="${BOOTS_DIR:-$(cd "$_SELF/../../../.." && pwd -P)}"
STATE_DIR="${BOOTS_STATE_DIR:-$HOME/.boots}"
CACHE_FILE="$STATE_DIR/last-update-check"
MARKER_FILE="$STATE_DIR/just-upgraded-from"
SNOOZE_FILE="$STATE_DIR/update-snoozed"
VERSION_FILE="$BOOTS_DIR/VERSION"
CONFIG_CMD="$_SELF/boots-config"

# ─── Force flag (busts cache + snooze for a manual /boots-upgrade) ──
if [ "${1:-}" = "--force" ]; then rm -f "$CACHE_FILE" "$SNOOZE_FILE"; fi

# ─── Kill switch ─────────────────────────────────────────────
[ "$("$CONFIG_CMD" get update_check 2>/dev/null || echo true)" = "false" ] && exit 0

# ─── Snooze helper (escalating: 1=24h, 2=48h, 3+=7d; new version resets) ──
check_snooze() {
  local remote="$1"
  [ -f "$SNOOZE_FILE" ] || return 1
  local v l e; v="$(awk '{print $1}' "$SNOOZE_FILE")"; l="$(awk '{print $2}' "$SNOOZE_FILE")"; e="$(awk '{print $3}' "$SNOOZE_FILE")"
  [ -z "$v" ] || [ -z "$l" ] || [ -z "$e" ] && return 1
  case "$l$e" in *[!0-9]*) return 1 ;; esac
  [ "$v" != "$remote" ] && return 1
  local dur; case "$l" in 1) dur=86400 ;; 2) dur=172800 ;; *) dur=604800 ;; esac
  [ "$(date +%s)" -lt $(( e + dur )) ] && return 0
  return 1
}

# ─── Local version ───────────────────────────────────────────
LOCAL=""; [ -f "$VERSION_FILE" ] && LOCAL="$(tr -d '[:space:]' < "$VERSION_FILE")"
[ -z "$LOCAL" ] && exit 0

# ─── Just-upgraded marker ────────────────────────────────────
if [ -f "$MARKER_FILE" ]; then
  OLD="$(tr -d '[:space:]' < "$MARKER_FILE")"; rm -f "$MARKER_FILE" "$SNOOZE_FILE"
  [ -n "$OLD" ] && echo "JUST_UPGRADED $OLD $LOCAL"
  # fall through to a remote check in case more landed since
fi

# ─── Cache (UP_TO_DATE 60m TTL, UPGRADE_AVAILABLE 720m TTL) ──
if [ -f "$CACHE_FILE" ]; then
  CACHED="$(cat "$CACHE_FILE" 2>/dev/null || true)"
  case "$CACHED" in UP_TO_DATE*) TTL=60 ;; UPGRADE_AVAILABLE*) TTL=720 ;; *) TTL=0 ;; esac
  if [ "$TTL" -gt 0 ] && [ -z "$(find "$CACHE_FILE" -mmin +$TTL 2>/dev/null)" ]; then
    case "$CACHED" in
      UP_TO_DATE*) [ "$(echo "$CACHED" | awk '{print $2}')" = "$LOCAL" ] && exit 0 ;;
      UPGRADE_AVAILABLE*)
        if [ "$(echo "$CACHED" | awk '{print $2}')" = "$LOCAL" ]; then
          NEW="$(echo "$CACHED" | awk '{print $3}')"
          check_snooze "$NEW" && exit 0
          echo "$CACHED"; exit 0
        fi ;;
    esac
  fi
fi

# ─── Slow path: resolve remote + fetch VERSION ───────────────
mkdir -p "$STATE_DIR"
REMOTE_REPO="${BOOTS_REMOTE_REPO:-$(git -C "$BOOTS_DIR" remote get-url origin 2>/dev/null || true)}"
[ -z "$REMOTE_REPO" ] && exit 0   # no upstream → nothing to check against

# HEAD sha via ls-remote (immediately consistent, unlike branch-raw CDN); 5s cap,
# no credential prompts, so a private/unreachable remote fails fast to silence.
REMOTE=""
_SHA="$(GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=5 \
  git ls-remote "$REMOTE_REPO" refs/heads/main 2>/dev/null | awk '{print $1}')"
# Derive a raw.githubusercontent base from a github origin (SSH or HTTPS).
_OWNER_REPO="$(printf '%s' "$REMOTE_REPO" | sed -E 's#^git@github\.com:##; s#^https://github\.com/##; s#\.git$##')"
if echo "$_SHA" | grep -qE '^[0-9a-f]{40}$' && echo "$REMOTE_REPO" | grep -q 'github\.com'; then
  REMOTE="$(curl -sf --max-time 5 "https://raw.githubusercontent.com/${_OWNER_REPO}/${_SHA}/VERSION" 2>/dev/null || true)"
  # Private repo → raw CDN 404s (it only serves public files). Fall back to the
  # authenticated GitHub API via gh, if installed. The public open-source path stays
  # primary (raw CDN, zero deps); gh is used only when the CDN returns nothing. The
  # raw Accept header returns the file verbatim, so there's no base64 to decode.
  if [ -z "$REMOTE" ] && command -v gh >/dev/null 2>&1; then
    REMOTE="$(gh api "repos/${_OWNER_REPO}/contents/VERSION?ref=${_SHA}" \
      -H "Accept: application/vnd.github.raw" 2>/dev/null || true)"
  fi
fi

# Host-agnostic fallback: ask git itself for the file. Every path above is
# GitHub-shaped (raw CDN, gh api), so without this a clone whose origin is
# GitLab, Codeberg or a self-hosted server would fall through with REMOTE empty
# and cache UP_TO_DATE — reporting itself current forever, with no error. Since
# the upstream is each user's own `origin`, that is every fork off GitHub.
# `git fetch --depth 1` writes only to .git (FETCH_HEAD + objects); it never
# touches the working tree, the index, or the checked-out branch. Same 5s cap
# and no-prompt env as the ls-remote above, so an unreachable or auth-walled
# remote still fails fast to silence rather than hanging a skill. This also
# covers a private GitHub repo on a machine with no gh CLI, which the raw CDN
# cannot serve and which otherwise returns the wrong answer silently.
if [ -z "$REMOTE" ] && echo "$_SHA" | grep -qE '^[0-9a-f]{40}$' && [ -d "$BOOTS_DIR/.git" ]; then
  if GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=5 \
     git -C "$BOOTS_DIR" fetch --quiet --depth 1 "$REMOTE_REPO" refs/heads/main 2>/dev/null; then
    REMOTE="$(git -C "$BOOTS_DIR" show FETCH_HEAD:VERSION 2>/dev/null || true)"
  fi
fi
REMOTE="$(printf '%s' "$REMOTE" | tr -d '[:space:]')"

# Validate it looks like a version (rejects HTML error pages)
echo "$REMOTE" | grep -qE '^[0-9]+\.[0-9.]+$' || { echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE"; exit 0; }
[ "$LOCAL" = "$REMOTE" ] && { echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE"; exit 0; }

# Semver-order guard: only flag when REMOTE sorts strictly higher (protects against
# stale CDN and dev installs running ahead of main).
[ "$(printf '%s\n%s\n' "$LOCAL" "$REMOTE" | sort -V | tail -1)" != "$REMOTE" ] && { echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE"; exit 0; }

echo "UPGRADE_AVAILABLE $LOCAL $REMOTE" > "$CACHE_FILE"
check_snooze "$REMOTE" && exit 0
echo "UPGRADE_AVAILABLE $LOCAL $REMOTE"
