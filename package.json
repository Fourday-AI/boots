{
  "name": "boots",
  "version": "0.1.0",
  "description": "Boots \u2014 a companion for building and finishing AI systems.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "gen:skill-docs": "bun run scripts/gen-skill-docs.ts",
    "gen:skill-docs:check": "bun run scripts/gen-skill-docs.ts --dry-run",
    "build:cowork": "bun run scripts/gen-skill-docs.ts --host cowork && bun run scripts/build-plugin.ts --host cowork",
    "build:cowork:check": "bun run scripts/build-plugin.ts --host cowork --check",
    "test": "bash scripts/test-e2e.sh",
    "test:live": "bash scripts/test-e2e.sh --live",
    "test:install": "bash scripts/test-install.sh",
    "test:lifecycle": "bash scripts/test-lifecycle.sh",
    "test:session": "bash scripts/test-session.sh"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
