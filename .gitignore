# macOS
.DS_Store

# Archives / bundles (not source)
*.zip

# Private runtime — legacy pre-migration session state (systems, archives).
# Holds summaries of private AI sessions; never commit.
/state/

# Secrets — API keys and scoped session URLs for hosted integrations.
# Configs reference these via ${VAR} expansion, never literals.
.env
.env.*

# Boots connection state (contains ids; keep out of git)
.connection.local.json
state/systems/*/.connection.local.json

# generated external-host skill docs (bun run gen:skill-docs --host <name>)
.agents/
.codex/
node_modules/

# ── Top-level allow-list (deny-by-default) ──────────────────────────────────
# This is an OPEN-SOURCE repo, and the product skills now live as top-level
# directories (so GitHub's landing page IS the skill list). `/*/` ignores EVERY
# top-level directory and only the ones below are un-ignored. A newly created
# directory — a private skill, client work, a half-baked experiment — is
# invisible to git until you add an explicit `!` line for it here, so nothing
# private can be committed by accident (not even via `git add -A`).
#
# When you ship a NEW product skill, add one line to the skills block below.
# Top-level FILES (README.md, VERSION, setup, …) are unaffected — `/*/` matches
# directories only.
/*/

# The product — one directory per skill. This is deliberately an explicit list,
# not a `boots*/` glob: a glob would silently auto-commit a `boots-clientwork/`.
!/boots/
!/boots-clarify/
!/boots-scope/
!/boots-build/
!/boots-review/
!/boots-verify/
!/boots-ship/
!/boots-prospect/
!/boots-track/
!/boots-surface/
!/boots-rethink/
!/boots-extract/
!/boots-retire/
!/boots-observe/
!/boots-upgrade/

# Supporting repo directories (engine, hosts, docs, backend, CI).
!/hosts/
!/scripts/
!/migrations/
!/docs/
!/supabase/
!/.github/
!/.githooks/

# .claude/ holds the tracked settings.json only. Its skills/ subdir is now the
# author's own private work (the product moved to the top level) — keep it out.
!/.claude/
/.claude/skills/

# Local-clone runtime state — created when Boots runs in this dev repo in place.
# The real per-user copies live under ~/.boots/; these top-level artifacts are
# NOT part of the product and must never be committed. systems/ in particular
# holds the author's own private systems (the same data ~/.boots/systems/ holds
# for a user). CLAUDE.md and IDEAS.md are deliberately absent here — both ARE
# tracked contributor docs.
/.activated
/.consent-prompted
/.hash-salt
/.last-setup-version
/analytics/
/config.yaml
/installation-id
/just-upgraded-from
/last-update-check
/map.md
/sessions/
/systems/
/update-snoozed

# Supabase CLI local state (version cache, temp files) — created by the CLI, never
# part of the product. The committed backend is supabase/{migrations,functions,config.sh}.
/supabase/.temp/

# Eval corpus — RAW session transcripts contain real client PII (names, account
# numbers, balances from live sessions). Never commit. The distilled, redacted
# eval CASES under evals/cases/ are safe and ARE committed.
/evals/transcripts/

# Build output for plugin-packaged hosts (bun run build:cowork). Already covered
# by the deny-by-default /*/ rule below — listed explicitly so it stays out even
# if someone later relaxes that rule.
/dist/
